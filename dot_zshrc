# ┌────────────────────────────────────────────────────────────────────────────┐
# │ ~/.zshrc                                                                   │
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Ambiente                                                                   │
# └────────────────────────────────────────────────────────────────────────────┘
export LANG=pt_BR.UTF-8
export LC_ALL=pt_BR.UTF-8
export EDITOR=nvim

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ PATH + Homebrew                                                            │
# └────────────────────────────────────────────────────────────────────────────┘
export PATH="$HOME/.local/bin:$PATH"
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Oh My Zsh                                                                  │
# └────────────────────────────────────────────────────────────────────────────┘
export ZSH="$HOME/.oh-my-zsh"

plugins=(
  alias-finder               # avisa quando você digita um comando que já tem alias
  chezmoi                    # completions + aliases do chezmoi (só útil se você usa chezmoi)
  colored-man-pages          # deixa as páginas do `man` coloridas
  command-not-found          # sugere qual pacote instalar quando o comando não existe
  gh                         # autocompletar do GitHub CLI (`gh`)
  zsh-autosuggestions        # sugere comandos do histórico em cinza (→ aceita)
  zsh-syntax-highlighting    # colore o comando enquanto digita; deve ser o ÚLTIMO da lista
)

source $ZSH/oh-my-zsh.sh

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Histórico                                                                  │
# └────────────────────────────────────────────────────────────────────────────┘
HISTSIZE=10000                # linhas mantidas em memória
SAVEHIST=10000                # linhas salvas no arquivo

setopt HIST_IGNORE_DUPS       # não salva duplicatas consecutivas
setopt HIST_IGNORE_SPACE      # não salva comandos que começam com espaço
setopt SHARE_HISTORY          # compartilha histórico entre sessões abertas

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Aliases                                                                    │
# └────────────────────────────────────────────────────────────────────────────┘
# ── Navegação ─────────────────────────────────────────────────────────────────
alias ~="cd ~"
alias ..="cd .."

# ── Listagem (eza é o fork mantido do exa) ────────────────────────────────────
alias l="eza --classify --color=always --all --sort=type --icons"
alias ls="eza --classify --color=always --all --sort=type --icons"
alias lt="eza --classify --color=always --all --sort=type --tree --level=2 --icons"
alias lg="eza --classify --color=always --all --sort=type --long --header --links --no-user --icons"

# ── Editor ────────────────────────────────────────────────────────────────────
alias vi=nvim
alias vim=nvim
alias i=nvim

# ── Ferramentas ───────────────────────────────────────────────────────────────
alias cat=bat
alias dl=yt-dlp
alias neofetch=fastfetch

# ── Git ───────────────────────────────────────────────────────────────────────
alias gs="git status"
alias gc="git commit"
alias gl="git log"

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Pure (prompt)                                                              │
# └────────────────────────────────────────────────────────────────────────────┘
fpath+=("$(brew --prefix)/share/zsh/site-functions") # se instalar pelo homebrew, adiciona o path do pure
autoload -U promptinit; promptinit
prompt pure

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ fzf (busca fuzzy)                                                          │
# └────────────────────────────────────────────────────────────────────────────┘
# Ctrl+R → histórico | Ctrl+T → arquivos
# Instalação: https://github.com/junegunn/fzf#installation
source /home/linuxbrew/.linuxbrew/opt/fzf/shell/completion.zsh 2>/dev/null || source <(fzf --zsh)

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ tmux (início automático apenas no uxterm)                                  │
# └────────────────────────────────────────────────────────────────────────────┘
# Só inicia o tmux se TODAS as condições forem verdadeiras:
#   1. shell interativo         → ignora scripts e `zsh -c`
#   2. fora do tmux             → evita loop (tmux dentro de tmux)
#   3. rodando no xterm/uxterm  → $XTERM_VERSION só existe nele, então
#                                 VS Code, TTY e outros terminais ficam de fora
#   4. fora de sessão SSH       → não interfere em acessos remotos
#   5. tmux instalado           → sem erro se ele não existir
if [[ -o interactive ]] \
   && [[ -z $TMUX ]] \
   && [[ -n $XTERM_VERSION ]] \
   && [[ -z $SSH_CONNECTION ]] \
   && (( $+commands[tmux] )); then
  # Sem `exec`: se o tmux falhar ao abrir, você continua num zsh normal.
  # Se ele fechar normalmente (exit ou detach), o terminal fecha junto.
  tmux new-session -A -s main && exit
fi
