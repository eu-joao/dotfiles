! aplicar configuraão: xrdb -merge ~/.Xresources

#include "/home/abacate/.Xresources.d/catppuccin-mocha"
#include "/home/abacate/.Xresources.d/template"

! ── Janela ──
UXTerm*maximized: true
UXTerm*internalBorder: 10
UXTerm*saveLines: 10000

! ── Fonte ──
! Monaspace Neon = MonaspiceNe Nerd Font Mono
! Monaspace Argon = MonaspiceAr Nerd Font Mono
! Monaspace Xenon = MonaspiceXe Nerd Font Mono
! Monaspace Radon = MonaspiceRn Nerd Font Mono
! Monaspace Krypton NF = MonaspiceKr Nerd Font Mono
! JetBrainsMono Nerd Font Mono
! FiraCode Nerd Font Mono
UXTerm*renderFont: true
UXTerm*faceName: FiraCode Nerd Font Mono
UXTerm*faceSize: 16

! ── Cursor: underline piscando ──
UXTerm*cursorUnderLine: true
UXTerm*cursorBlink: true
UXTerm*cursorOnTime: 500
UXTerm*cursorOffTime: 500

! ── Clipboard (seleção também vai para o CLIPBOARD) ──
UXTerm*selectToClipboard: true

! ── Truecolor e imagens (sixel) ──
UXTerm*directColor: true
UXTerm*decTerminalID: vt340
UXTerm*numColorRegisters: 256
UXTerm*sixelScrolling: true

! ── Trocar tema sem reiniciar o terminal ──
UXTerm*dynamicColors: true

! ── Interação com fastfetch  ──
UXTerm*allowWindowOps: true

! ── Atalhos (iguais aos do wezterm) ──
UXTerm*VT100.translations: #override \n\
    Ctrl Shift <Key>J: scroll-forw(1,line) \n\
    Ctrl Shift <Key>K: scroll-back(1,line) \n\
    Ctrl Shift <Key>D: scroll-forw(1,halfpage) \n\
    Ctrl Shift <Key>U: scroll-back(1,halfpage) \n\
    Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V: insert-selection(CLIPBOARD) \n\
    Ctrl <Key>plus: larger-vt-font() \n\
    Ctrl <Key>minus: smaller-vt-font()
