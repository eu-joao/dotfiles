# ┌────────────────────────────────────────────────────────────────────────────┐
# │ ~/.zshrc                                                                   │
# └────────────────────────────────────────────────────────────────────────────┘

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Ambiente                                                                   │
# └────────────────────────────────────────────────────────────────────────────┘
export LANG=pt_BR.UTF-8
export LC_ALL=pt_BR.UTF-8
export EDITOR=nvim
export MANPAGER="sh -c 'col -bx | bat -l man -p'"   # man colorido via bat

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ PATH + Homebrew                                                            │
# └────────────────────────────────────────────────────────────────────────────┘
export PATH="$HOME/.local/bin:$PATH"
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Oh My Zsh                                                                  │
# └────────────────────────────────────────────────────────────────────────────┘
# O site-functions do brew (pure e completions de gh e chezmoi) entra no fpath
# antes do OMZ, que roda o compinit. autosuggestions e syntax-highlighting vêm
# do brew (seção Plugins), por isso a lista de plugins do OMZ fica vazia.
fpath+=("$HOMEBREW_PREFIX/share/zsh/site-functions")

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                           # o prompt é o pure
zstyle ':omz:update' mode disabled     # sem checagem de atualização ao abrir o shell
ZSH_DISABLE_COMPFIX=true               # pula o compaudit (auditoria de segurança do compinit)
plugins=()

source $ZSH/oh-my-zsh.sh

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Histórico                                                                  │
# └────────────────────────────────────────────────────────────────────────────┘
HISTSIZE=10000                # linhas mantidas em memória
SAVEHIST=10000                # linhas salvas no arquivo

setopt HIST_IGNORE_DUPS       # não salva duplicatas consecutivas
setopt HIST_IGNORE_SPACE      # não salva comandos que começam com espaço
setopt SHARE_HISTORY          # compartilha histórico entre sessões abertas

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Aliases                                                                    │
# └────────────────────────────────────────────────────────────────────────────┘
# ── Navegação ─────────────────────────────────────────────────────────────────
alias ~="cd ~"
alias ..="cd .."

# ── Listagem (eza é o fork mantido do exa) ────────────────────────────────────
alias l="eza --classify --color=always --all --sort=type --icons"
alias ls="eza --classify --color=always --all --sort=type --icons"
alias lt="eza --classify --color=always --all --sort=type --tree --level=2 --icons"
alias lg="eza --classify --color=always --all --sort=type --long --header --links --no-user --icons"

# ── Editor ────────────────────────────────────────────────────────────────────
alias vi=nvim
alias vim=nvim
alias i=nvim

# ── Ferramentas ───────────────────────────────────────────────────────────────
alias cat=bat
alias dl=yt-dlp
alias neofetch=fastfetch

# ── Git ───────────────────────────────────────────────────────────────────────
alias gs="git status"
alias gc="git commit"
alias gl="git log"

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Pure (prompt)                                                              │
# └────────────────────────────────────────────────────────────────────────────┘
autoload -U promptinit; promptinit
prompt pure

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ fzf (busca fuzzy)                                                          │
# └────────────────────────────────────────────────────────────────────────────┘
# Ctrl+R → histórico | Ctrl+T → arquivos
# Instalação: https://github.com/junegunn/fzf#installation
source "$HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh" 2>/dev/null || source <(fzf --zsh)

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Plugins (brew install zsh-autosuggestions zsh-syntax-highlighting)         │
# └────────────────────────────────────────────────────────────────────────────┘
# Ficam no fim, depois de todos os widgets. O syntax-highlighting vem por último.
source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"       # sugere comandos do histórico em cinza (→ aceita)
source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"   # colore o comando enquanto digita
