{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "~/.config/fastfetch/logo.jpeg",
    "height": 10,
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "key": {
      "width": 12
    }
  },
  "modules": [
    {
      "type": "colors",
      "brightness": "normal"
    },
    "break",
    {
      "type": "title",
      "key": "User",
      "format": "{user-name}"
    },
    {
      "type": "os",
      "format": "{pretty-name}"
    },
    "kernel",
    "uptime",
    {
      "type": "de",
      "key": "Desktop"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    "shell"
  ]
}
