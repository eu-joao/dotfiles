# ┌────────────────────────────────────────────────────────────────────────────┐
# │ gruvbox.colors                                                             │
# └────────────────────────────────────────────────────────────────────────────┘
# Tema de cores Gruvbox para o herdr.conf. Mesmos nomes em todos os temas.
# Só valores fixos (hex): o tmux não expande uma variável dentro de outra.
# Troca de tema: ver "Tema" no dot_tmux.conf.
# O crust precisa ser igual ao fundo do terminal (C_BG do tema gruvbox no Xresources).

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Cores do Gruvbox                                                           │
# └────────────────────────────────────────────────────────────────────────────┘

# ── Fundos (do mais escuro ao mais claro) ─────────────────────────────────────
set -g @herdr-crust     "#282828"   # fundo dos painéis e da área principal (igual ao C_BG do terminal)
set -g @herdr-mantle    "#2d2b2a"   # tom intermediário (reserva)
set -g @herdr-base      "#32302f"   # fundo da barra de abas

# ── Superfícies e textos ──────────────────────────────────────────────────────
set -g @herdr-surface0  "#3c3836"   # caixas de mensagem e traços entre as abas
set -g @herdr-surface1  "#504945"   # borda dos painéis
set -g @herdr-surface2  "#665c54"   # separadores discretos
set -g @herdr-overlay0  "#7c6f64"   # texto apagado (título de painel inativo)
set -g @herdr-overlay1  "#928374"   # texto de aba inativa
set -g @herdr-subtext0  "#a89984"   # texto secundário e busca no modo de cópia
set -g @herdr-text      "#ebdbb2"   # texto principal

# ── Cores de destaque ─────────────────────────────────────────────────────────
set -g @herdr-mauve     "#d3869b"   # destaque (aba ativa e nome do painel em foco)
set -g @herdr-yellow    "#fabd2f"   # aviso e resultado atual da busca
set -g @herdr-red       "#fb4934"   # prefixo pressionado e sino
set -g @herdr-green     "#b8bb26"   # cor de apoio (reserva)
set -g @herdr-teal      "#8ec07c"   # cor de apoio (reserva)
