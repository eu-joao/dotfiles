# ┌────────────────────────────────────────────────────────────────────────────┐
# │ dracula.colors                                                             │
# └────────────────────────────────────────────────────────────────────────────┘
# Tema de cores Dracula para o herdr.conf. Mesmos nomes em todos os temas.
# Só valores fixos (hex): o tmux não expande uma variável dentro de outra.
# Troca de tema: ver "Tema" no dot_tmux.conf.
# O crust precisa ser igual ao fundo do terminal (C_BG do tema dracula no Xresources).

# ┌────────────────────────────────────────────────────────────────────────────┐
# │ Cores do Dracula                                                           │
# └────────────────────────────────────────────────────────────────────────────┘

# ── Fundos (do mais escuro ao mais claro) ─────────────────────────────────────
set -g @herdr-crust     "#282a36"   # fundo dos painéis e da área principal (igual ao C_BG do terminal)
set -g @herdr-mantle    "#2d2f3d"   # tom intermediário (reserva)
set -g @herdr-base      "#343746"   # fundo da barra de abas

# ── Superfícies e textos ──────────────────────────────────────────────────────
set -g @herdr-surface0  "#3b3e4f"   # caixas de mensagem e traços entre as abas
set -g @herdr-surface1  "#44475a"   # borda dos painéis
set -g @herdr-surface2  "#565b78"   # separadores discretos
set -g @herdr-overlay0  "#6272a4"   # texto apagado (título de painel inativo)
set -g @herdr-overlay1  "#8791bd"   # texto de aba inativa
set -g @herdr-subtext0  "#bfc3d9"   # texto secundário e busca no modo de cópia
set -g @herdr-text      "#f8f8f2"   # texto principal

# ── Cores de destaque ─────────────────────────────────────────────────────────
set -g @herdr-mauve     "#bd93f9"   # destaque (aba ativa e nome do painel em foco)
set -g @herdr-yellow    "#f1fa8c"   # aviso e resultado atual da busca
set -g @herdr-red       "#ff5555"   # prefixo pressionado e sino
set -g @herdr-green     "#50fa7b"   # cor de apoio (reserva)
set -g @herdr-teal      "#8be9fd"   # cor de apoio (reserva)
